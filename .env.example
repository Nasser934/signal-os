# Signal OS - Environment Variables
# Copy to .env.local and fill in your keys

# Backend API
VITE_API_URL=https://api.signalos.app

# Nango OAuth (https://app.nango.dev)
VITE_NANGO_PUBLIC_KEY=nango_public_key_here
VITE_NANGO_HOST=https://api.nango.dev

# PostHog Analytics (https://app.posthog.com)
VITE_POSTHOG_KEY=ph_project_api_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Environment
VITE_APP_ENV=development
