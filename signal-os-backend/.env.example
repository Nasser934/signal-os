# Signal OS Backend - Environment Variables

# Database (Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@localhost:5432/signalos

# Security (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# Nango (https://app.nango.dev)
NANGO_SECRET_KEY=nango-secret-key
NANGO_HOST=https://api.nango.dev

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://signalos.app

# Server
PORT=8787
